{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "react", "react-dom", "vitest/globals"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "noUncheckedIndexedAccess": false
  },
  // "test/**/*" rather than "test/*.ts": the panel tests live in
  // test/configpanel and are .ts files that import .tsx panel sources, so a
  // top-level-only glob left ten of them type-checked by nothing.
  "include": ["src/**/*.ts", "src/configpanel/**/*", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
